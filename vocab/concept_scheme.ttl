datin_imkt_vocab:abrasive_blasting a construct:PlannedProcess, dcat:Resource, nfdi4cat:voc4cat_0000185, obo:BFO_0000015, obo:OBI_0000011, prov:Entity, schema:Action, skos:Concept;
    datacite:date "2026-07-23T14:44:33.389+02:00"^^xsd:dateTime;
