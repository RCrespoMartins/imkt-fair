datin_imkt_vocab:abrasive_machining a construct:PlannedProcess, dcat:Resource, nfdi4cat:voc4cat_0000185, obo:BFO_0000015, obo:OBI_0000011, prov:Entity, schema:Action, skos:Concept;
    datacite:date "2026-07-23T14:41:30.623+02:00"^^xsd:dateTime;
